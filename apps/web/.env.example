# Supabase project (same project the node fleet and edge functions are deployed to).
# Find these under Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# VAPID public key for Web Push (base64url). Must match the VAPID_PUBLIC_KEY
# secret configured on the Supabase edge functions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
